# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# PostgreSQL 14+ with the pgvector extension available.
# The default matches docker-compose.dev.yml. (docker-compose.yml
# overrides it to point at its bundled `db` service.)
DATABASE_URL=postgresql://chatdesk:chatdesk@localhost:5432/chatdesk

# S3-compatible object storage for media (SeaweedFS, AWS S3, Cloudflare
# R2, Backblaze B2, ...). Defaults match docker-compose.dev.yml. The bucket
# is created on first use if it doesn't exist. It never needs to be
# public: media is served through the app at /api/storage/....
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=chatdesk
S3_SECRET_KEY=chatdesk-dev-secret
S3_BUCKET=chatdesk
# S3_REGION=us-east-1

# WhatsApp token / AI key encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every secret encrypted under the previous
# key — users have to re-save their WhatsApp and AI settings.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# DOCKER COMPOSE — only read by docker-compose.yml.
# ============================================================

# Credentials for the bundled Postgres and object-storage containers.
# POSTGRES_PASSWORD=change-me
# STORAGE_ACCESS_KEY=chatdesk
# STORAGE_SECRET_KEY=change-me-too
# Publish the app on a different host port (the container always
# listens on 3000).
# HOST_PORT=3000

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for links in emails and invites, the sitemap and OG
# images. Password-reset emails are only sent when this (or
# ALLOWED_INVITE_HOSTS) is set in production, so the link can't be
# pointed at another host via a forged Host header.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# Outgoing email (password resets) over plain SMTP — any provider.
# When SMTP_HOST is unset, emails are printed to the server log instead
# (handy locally: copy the reset link from the console). Locally,
# docker-compose.dev.yml runs Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASSWORD=
# SMTP_FROM="ChatDesk <no-reply@example.com>"
# SMTP_SECURE=false   # true for implicit TLS (port 465)

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Allow-list of hostnames that invite / password-reset links may point
# at when NEXT_PUBLIC_SITE_URL is unset (comma-separated hostnames, no
# scheme or port). Without either, a request's Host header could be
# spoofed to plant a link to another site.
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Background jobs (automation Wait steps, stale flow-run sweep, expired
# session cleanup) run inside the app every minute. When running several
# app replicas, set DISABLE_INTERNAL_CRON=true on all but one — or on
# all, and call GET /api/automations/cron and /api/flows/cron from an
# external scheduler with `x-cron-secret: $AUTOMATION_CRON_SECRET`.
# DISABLE_INTERNAL_CRON=false
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Database connection pool size per app process. Default 10.
# DATABASE_POOL_MAX=10

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# Bring-your-own-key: each account pastes its own OpenAI or Anthropic
# key under Settings → AI Assistant, stored encrypted with
# ENCRYPTION_KEY. No global provider key is needed. The knowledge base
# uses Postgres full-text search, plus pgvector semantic search when an
# account adds an embeddings key.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------
# A THROWAWAY Postgres database for `npm run test:db` — it is wiped and
# re-migrated on every run. Never point it at real data.
# TEST_DATABASE_URL=postgresql://chatdesk:chatdesk@localhost:5432/chatdesk_test
